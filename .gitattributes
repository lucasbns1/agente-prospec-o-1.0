# Normaliza quebras de linha. Critico no Windows: sem isso o Git converte
# arquivos para CRLF no checkout e scripts/migrations quebram dentro do
# container Docker (que e Linux).
* text=auto eol=lf

# Arquivos que precisam de CRLF no Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios — nunca converter
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.xlsx binary
*.zip binary
