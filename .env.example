# =============================================================================
# PROSPECTOR — exemplo de configuracao
#
# Copie este arquivo para `.env` e ajuste os valores.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Windows (CMD):         copy .env.example .env
#
# O arquivo `.env` esta no .gitignore e NUNCA deve ser commitado.
#
# O sistema roda 100% local e funciona SEM nenhuma API key externa.
# A unica integracao externa opcional e o Gemini, no fim deste arquivo:
# desligada por padrao, e usada apenas para decidir a proxima acao da
# cadencia — nunca para enviar mensagem.
# =============================================================================

# -----------------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL local, via Docker Compose)
# -----------------------------------------------------------------------------
# Estas 3 variaveis sao lidas pelo docker-compose.yml para criar o container.
POSTGRES_USER=prospector
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=prospector

# String de conexao usada pelo Prisma. Se mudar usuario/senha/db acima,
# atualize aqui tambem (os valores precisam bater).
DATABASE_URL=postgresql://prospector:troque_esta_senha@localhost:5432/prospector?schema=public

# -----------------------------------------------------------------------------
# REDIS (filas BullMQ, via Docker Compose)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_PORT=3333
API_HOST=127.0.0.1

# Segredo usado para assinar o cookie de sessao.
# GERE UM VALOR ALEATORIO PROPRIO — nao use o exemplo abaixo.
# Como gerar:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=gere_um_valor_aleatorio_de_no_minimo_32_caracteres

# Duracao da sessao em dias
SESSION_TTL_DAYS=30

# Origem permitida no CORS (o frontend Vite)
WEB_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# USUARIO INICIAL (usado apenas pelo `pnpm db:seed`)
# -----------------------------------------------------------------------------
# O sistema e monousuario. Estes valores criam o primeiro login.
# TROQUE A SENHA antes de rodar o seed.
SEED_USER_EMAIL=admin@local
SEED_USER_NAME=Administrador
SEED_USER_PASSWORD=troque_esta_senha_tambem

# -----------------------------------------------------------------------------
# WHATSAPP
# -----------------------------------------------------------------------------
# Modo de operacao do adapter:
#   dry-run  = SIMULA os envios. Nada e enviado de verdade. (PADRAO)
#   live     = envia de verdade via whatsapp-web.js (disponivel a partir da Fase 8)
#
# COMECE SEMPRE EM dry-run. So mude para `live` depois de validar todo o fluxo.
# Qual canal usar para CONECTAR.
#   simulado      = nao abre navegador, nao conecta em lugar nenhum (padrao)
#   whatsapp-web  = conecta de verdade, pede QR e RECEBE mensagens reais
#
# Conectar e enviar sao coisas separadas: mesmo com whatsapp-web, o envio
# continua bloqueado pela guarda de fase (guarda-envio.ts).
WHATSAPP_CANAL=simulado


# Onde a sessao do WhatsApp fica salva no disco, para nao pedir QR Code
# toda vez. Esta pasta esta no .gitignore e contem credenciais da sua conta.
WHATSAPP_SESSION_PATH=./data/whatsapp

# Caminho do Chrome. Deixe vazio para deteccao automatica.
# Windows normalmente:  C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=

# -----------------------------------------------------------------------------
# VERSAO DO WHATSAPP WEB
# -----------------------------------------------------------------------------
# O whatsapp-web.js injeta codigo que depende da estrutura interna da
# pagina do WhatsApp Web. Quando o WhatsApp publica uma versao nova, essa
# estrutura muda e a injecao para de encontrar o que procura.
#
# O sintoma NAO denuncia a causa: mensagem recebida continua chegando
# (os eventos funcionam), mas toda consulta ao historico falha com um
# erro opaco de dentro do Chromium — literalmente `message: "r"`, porque
# o codigo da pagina esta minificado. No log aparece assim:
#
#   getChats falhou; a pagina do WhatsApp pode ainda estar carregando
#   getChats falhou de vez; buscando conversa por conversa
#   Conversas recuperadas uma a uma  ->  encontradas: 0
#
# Se voce esta vendo isso, PREENCHA a variavel abaixo. Ela fixa qual
# build o Chrome carrega, escolhendo um em que a injecao funciona.
#
# VAZIO = pega o que o WhatsApp servir (padrao, e o que quebra quando
# eles atualizam).
#
# Como escolher outra versao, se a de baixo nao resolver:
#   1. abra https://github.com/wppconnect-team/wa-version/tree/main/html
#   2. escolha um arquivo com data ANTERIOR ao dia em que parou de
#      funcionar, e que ainda nao tenha expirado
#   3. cole o nome dele aqui, SEM o ".html"
#   4. reinicie o worker
#
# Pode ser preciso ler o QR Code de novo ao trocar de versao.
WHATSAPP_WEB_VERSION=

# De onde baixar o build fixado. `{version}` e substituido pelo valor
# acima. So e usado quando WHATSAPP_WEB_VERSION esta preenchida.
WHATSAPP_WEB_VERSION_URL=https://raw.githubusercontent.com/wppconnect-team/wa-version/main/html/{version}.html

# -----------------------------------------------------------------------------
# RECONCILIACAO — o worker conferindo o WhatsApp de tempos em tempos
# -----------------------------------------------------------------------------
# O evento `message` do WhatsApp so existe AO VIVO. Se o worker estiver
# fora do ar no instante em que o lead responde, aquele evento nunca e
# reentregue: a mensagem fica no celular e o sistema nunca soube dela.
#
# A varredura conserta isso lendo o historico das conversas e passando o
# que faltou pelo MESMO pipeline das mensagens ao vivo. A idempotencia
# por `whatsapp_message_id` e o que torna isso seguro de repetir.
#
# De quanto em quanto tempo varrer, em minutos.
#   0 desliga a varredura periodica (a da conexao continua acontecendo).
# Cinco minutos custa quase nada: conversas paradas sao descartadas pelo
# timestamp do chat ANTES de qualquer mensagem ser lida.
WHATSAPP_RECONCILIATION_INTERVAL_MINUTES=5

# Quanto tempo para tras olhar, em horas.
# 72h cobre um fim de semana inteiro com o worker desligado — que e
# exatamente o caso que motivou isto existir.
WHATSAPP_RECONCILIATION_WINDOW_HOURS=72

# -----------------------------------------------------------------------------
# LOGS
# -----------------------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# development = logs coloridos e legiveis | production = JSON
NODE_ENV=development

# -----------------------------------------------------------------------------
# GEMINI — orquestracao da cadencia por IA (Fase 9)
# -----------------------------------------------------------------------------
# O sistema funciona SEM isto. Com GEMINI_ENABLED=false — o padrao — a
# cadencia e comandada pelo motor deterministico, exatamente como antes.
#
# A chave e lida SOMENTE pelo processo do worker. Ela nao vai para a API,
# nao vai para o frontend, nao e gravada no banco e nao aparece em log.
#
# Pegue a sua em: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Liga a consulta ao modelo.
GEMINI_ENABLED=false

# MODO SOMBRA. true = a IA analisa e recomenda, mas quem COMANDA a
# cadencia continua sendo o motor deterministico.
#
# O padrao e false: ligar o Gemini significa dar o comando a ele. A
# guarda determinista continua filtrando toda decisao, e as quatro
# barreiras de envio continuam entre a decisao e o WhatsApp.
#
# Ponha true se quiser observar antes de liberar. Nesse caso, acompanhe:
#   SELECT acao_ia, acao_motor, COUNT(*) FROM ai_decisions
#   WHERE divergiu GROUP BY 1, 2;
AI_ANALYSIS_ONLY=false

GEMINI_MODEL=gemini-3.6-flash

# Passou disto, o motor deterministico assume e a cadencia continua.
GEMINI_TIMEOUT_MS=20000

